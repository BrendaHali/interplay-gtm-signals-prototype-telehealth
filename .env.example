# Required for live pipeline execution
OPENSTATES_API_KEY=
ANTHROPIC_API_KEY=
SLACK_WEBHOOK_URL=

# Required for SEC EDGAR queries (any valid email; SEC requires a contact header)
SEC_EDGAR_CONTACT=

# Recommended for openFDA queries. Without a key, the openFDA rate limit is
# 40 requests / hour and 1,000 / day per IP, which is contended on shared
# GitHub Actions runner IPs. Register at https://open.fda.gov/apis/authentication/
# for the 120 / minute and 120,000 / day tier. Accepts either env name.
API_DATA_GOV_KEY=
OPENFDA_API_KEY=

# Optional: BigQuery sink for analytics layer
GCP_PROJECT_ID=
GCP_BIGQUERY_DATASET=policy_signals
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: NewsAPI fallback for AG enforcement signal (free tier 100 req/day)
NEWSAPI_KEY=
